<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PocketDeadlock</AssemblyName>
    <Version>0.6.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app-icon.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PocketDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);DIAGNOSTICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PocketDiagnostics)' != 'true'">
    <Compile Remove="SelfTests*.cs" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" /><PackageReference Include="SharpCompress" Version="0.50.4" /></ItemGroup>
  <ItemGroup>
    <None Remove="assets\app-icon.ico" />
    <Resource Include="assets\app-icon.ico" />
  </ItemGroup>
</Project>
